                    },
                    "key": "x-api-key",
                    "value": "<API Key>"
                  },
                  {
                    "disabled": false,
                    "description": "Simulation output ID to associate the spans with. Use for\nsimulation-based flows. Mutually exclusive with `X-Conversation-Id`.\n",
                    "key": "X-Simulation-Id",
                    "value": "a1b2c3d4"
                  },
                  {
                    "disabled": false,
                    "description": "Conversation (Run) ID returned by `POST /v1/conversations:submit`.\nUse for monitoring flows. Mutually exclusive with `X-Simulation-Id`.\n",
                    "key": "X-Conversation-Id",
                    "value": "01H8XYZABCDEFG"
                  },
                  {
                    "key": "Accept",
                    "value": "application/json"
                  }
                ],
                "method": "POST",
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"resourceSpans\": [\n    {\n      \"resource\": {\n        \"attributes\": [\n          {\n            \"key\": \"service.name\",\n            \"value\": {\n              \"stringValue\": \"my-agent\"\n            }\n          }\n        ]\n      },\n      \"scopeSpans\": [\n        {\n          \"scope\": {\n            \"name\": \"my-tracer\"\n          },\n          \"spans\": [\n            {\n              \"traceId\": \"5b8aa5a2d2c872e8321cf37308d69df2\",\n              \"spanId\": \"051581bf3cb55c13\",\n              \"name\": \"llm\",\n              \"kind\": 1,\n              \"startTimeUnixNano\": \"1738000000000000000\",\n              \"endTimeUnixNano\": \"1738000001000000000\",\n              \"attributes\": [\n                {\n                  \"key\": \"metrics.ttfb\",\n                  \"value\": {\n                    \"doubleValue\": 0.42\n                  }\n                }\n              ],\n              \"status\": {\n                \"code\": 1\n              }\n            }\n          ]\n        }\n      ]\n    }\n  ]\n}",
                  "options": {
                    "raw": {
                      "language": "json"
                    }
                  }
                }
              },
              "status": "OK",
              "code": 200,
              "header": [
                {
                  "key": "Content-Type",
                  "value": "application/json"
                }
              ],
              "body": "{\n  \"status\": \"ok\",\n  \"simulation_output_id\": \"a1b2c3d4\"\n}",
              "cookie": [],
              "_postman_previewlanguage": "json"
            },
